# Warframe Market account credentials or JWT session token.
# WARFRAME_MARKET_EMAIL can be replaced with WARFRAME_MARKET_LOGIN if that is clearer for you.
WARFRAME_MARKET_EMAIL=seller@example.com
WARFRAME_MARKET_PASSWORD=change-me
# If Cloudflare blocks automated signin (403 on warframe.market), copy your JWT cookie from browser DevTools:
# WARFRAME_MARKET_JWT_TOKEN=eyJ0eXAi...
# WARFRAME_MARKET_CSRF_TOKEN=...

# Telegram bot settings.
# Create a bot with @BotFather and put its token here.
TELEGRAM_BOT_TOKEN=123456789:replace-with-token

# Chat id where notifications should be sent.
# It can be a user id, group id, or channel id where the bot has permission to write.
TELEGRAM_CHAT_ID=123456789

# Polling and persistence.
POLL_INTERVAL_SECONDS=30
STATE_PATH=/app/data/state.sqlite

# Warframe Market request context.
WARFRAME_MARKET_PLATFORM=pc
WARFRAME_MARKET_LANGUAGE=en
WARFRAME_MARKET_CROSSPLAY=true
WARFRAME_MARKET_MAX_RPS=3.0
WARFRAME_MARKET_MAX_RPM=10.0

# Usually you should not change these.
WARFRAME_MARKET_BASE_URL=https://warframe.market
WARFRAME_MARKET_API_BASE_URL=https://api.warframe.market/v1
TELEGRAM_API_BASE_URL=https://api.telegram.org
REQUEST_TIMEOUT_SECONDS=20

# Telegram Mini App and Riven Sniper
WEB_PORT=8080
WEB_APP_URL=https://your-domain.cloudflare.com
# Optional secret token for direct browser access (outside Telegram Mini App)
WEB_APP_SECRET_TOKEN=my_super_secret_token_123
RIVEN_POLL_INTERVAL_SECONDS=5
MAX_ALERTS_PER_RULE_RUN=3
SEEN_AUCTION_TTL_DAYS=7

# Cloudflare Tunnel Configuration (Production)
# Token from Cloudflare Zero Trust Dashboard (Networks -> Tunnels)
TUNNEL_TOKEN=eyJh...
CLOUDFLARE_TUNNEL_COMMAND="tunnel --no-autoupdate run"

# For Quick Temporary Tunnel without domain (trycloudflare.com):
# CLOUDFLARE_TUNNEL_COMMAND="tunnel --no-autoupdate run --url http://market-message:8080"



